{
  "version": 1,
  "steps": [
    { "action": "jumpTo", "state": "In" },
    { "action": "setPayload", "compositionId": "<composition-id>", "payload": { "Game Clock": { "UTC": 0, "isRunning": false, "value": 900000 } } },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "expected-zero" },
    { "action": "timerAction", "compositionId": "<composition-id>", "controlId": "Game Clock", "command": "reset" },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "beginning" },
    { "action": "timerAction", "compositionId": "<composition-id>", "controlId": "Game Clock", "command": "start" },
    { "action": "wait", "milliseconds": 2500 },
    { "action": "capture", "name": "running" },
    { "action": "assertPixelsChanged", "from": "beginning", "to": "running", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "timerAction", "compositionId": "<composition-id>", "controlId": "Game Clock", "command": "pause" },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "paused" },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "paused-later" },
    { "action": "assertPixelsMatch", "from": "paused", "to": "paused-later", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "setPayload", "compositionId": "<composition-id>", "payload": { "Game Clock": { "UTC": 0, "isRunning": false, "value": 898000 } } },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "near-end" },
    { "action": "assertPixelsChanged", "from": "beginning", "to": "near-end", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "timerAction", "compositionId": "<composition-id>", "controlId": "Game Clock", "command": "play" },
    { "action": "wait", "milliseconds": 3500 },
    { "action": "capture", "name": "zero" },
    { "action": "assertPixelsChanged", "from": "near-end", "to": "zero", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "assertPixelsMatch", "from": "expected-zero", "to": "zero", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "wait", "milliseconds": 2200 },
    { "action": "capture", "name": "zero-later" },
    { "action": "assertPixelsMatch", "from": "zero", "to": "zero-later", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "timerAction", "compositionId": "<composition-id>", "controlId": "Game Clock", "command": "reset" },
    { "action": "wait", "milliseconds": 1200 },
    { "action": "capture", "name": "reset" },
    { "action": "assertPixelsMatch", "from": "beginning", "to": "reset", "region": { "unit": "percent", "x": 0, "y": 0, "width": 100, "height": 100 } },
    { "action": "assertLifecycle", "event": "error", "equals": 0 }
  ]
}