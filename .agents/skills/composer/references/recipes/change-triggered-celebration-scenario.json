{
  "version": 1,
  "steps": [
    { "action": "jumpTo", "state": "In" },
    { "action": "setPayload", "payload": { "Celebration Enabled": false } },
    { "action": "setPayload", "payload": { "ShowOverlay": true, "GoalsHome": 1, "GoalsAway": 0, "NameHome": "Home Team", "NameAway": "Away Team" } },
    { "action": "wait", "milliseconds": 600 },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "capture", "name": "baseline" },
    { "action": "setPayload", "payload": { "GoalsHome": 2 } },
    { "action": "wait", "milliseconds": 600 },
    { "action": "capture", "name": "expected-new-score" },
    { "action": "setPayload", "payload": { "GoalsHome": 1 } },
    { "action": "jumpTo", "compositionId": "celebration-fixture", "state": "In" },
    { "action": "wait", "milliseconds": 600 },
    { "action": "capture", "name": "opaque-cover-reference" },
    { "action": "jumpTo", "compositionId": "celebration-fixture", "state": "Out" },
    { "action": "setPayload", "payload": { "Celebration Enabled": true } },
    { "action": "wait", "milliseconds": 600 },
    { "action": "assertState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "capture", "name": "seeded-enabled" },
    { "action": "assertPixelsMatch", "from": "baseline", "to": "seeded-enabled" },
    { "action": "setPayload", "payload": { "GoalsHome": 2 } },
    { "action": "wait", "milliseconds": 100 },
    { "action": "capture", "name": "early-cover" },
    { "action": "assertPixelsMatch", "from": "opaque-cover-reference", "to": "early-cover", "region": { "unit": "percent", "x": 44, "y": 35, "width": 12, "height": 30 } },
    { "action": "wait", "milliseconds": 4600 },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "capture", "name": "revealed-new-score" },
    { "action": "assertPixelsMatch", "from": "expected-new-score", "to": "revealed-new-score" },
    { "action": "setPayload", "payload": { "GoalsHome": 1 } },
    { "action": "wait", "milliseconds": 600 },
    { "action": "assertState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "capture", "name": "decrement" },
    { "action": "assertPixelsMatch", "from": "baseline", "to": "decrement" },
    { "action": "setPayload", "payload": { "Celebration Enabled": false } },
    { "action": "setPayload", "payload": { "GoalsHome": 2 } },
    { "action": "wait", "milliseconds": 600 },
    { "action": "assertState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "capture", "name": "disabled" },
    { "action": "assertPixelsMatch", "from": "expected-new-score", "to": "disabled" },
    { "action": "setPayload", "payload": { "Celebration Enabled": true } },
    { "action": "setPayload", "payload": { "GoalsAway": 1 } },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "In" },
    { "action": "setPayload", "payload": { "ShowOverlay": false } },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "setPayload", "payload": { "ShowOverlay": true, "GoalsAway": 2 } },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "In" },
    { "action": "setPayload", "payload": { "Celebration Enabled": false } },
    { "action": "waitForState", "compositionId": "celebration-fixture", "equals": "Out" },
    { "action": "assertLifecycle", "event": "error", "equals": 0 }
  ]
}