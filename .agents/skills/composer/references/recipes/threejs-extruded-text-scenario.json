{
  "version": 1,
  "steps": [
    { "action": "setPayload", "compositionId": "OWNER", "payload": "BASELINE_PAYLOAD" },
    { "action": "jumpTo", "compositionId": "OWNER", "state": "In" },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "baseline" },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Text": "B8O", "Font": "FONT_A", "Animate": false } },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "font-a" },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Font": "FONT_B400" } },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "font-b400" },
    { "action": "assertPixelsChanged", "from": "font-a", "to": "font-b400", "region": "TEXT_REGION", "minimumChangedPixels": 100, "tolerance": 8 },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Font": "FONT_B800" } },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "font-b800" },
    { "action": "assertPixelsChanged", "from": "font-b400", "to": "font-b800", "region": "TEXT_REGION", "minimumChangedPixels": 100, "tolerance": 8 },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Depth": "0.35", "Bevel": "0.04", "Roughness": "0.25", "Text": "Outline" } },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "numeric-strings" },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Text": "" } },
    { "action": "wait", "milliseconds": 250 },
    { "action": "capture", "name": "empty-text" },
    { "action": "assertPixelsChanged", "from": "numeric-strings", "to": "empty-text", "region": "TEXT_REGION", "minimumChangedPixels": 100, "tolerance": 8 },
    { "action": "setPayload", "compositionId": "OWNER", "payload": "BASELINE_PAYLOAD" },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "restored" },
    { "action": "assertPixelsMatch", "from": "baseline", "to": "restored", "tolerance": 8, "maximumChangedPixels": 0 },
    { "action": "setPayload", "compositionId": "OWNER", "payload": { "Animate": true, "Speed": "0.5" } },
    { "action": "wait", "milliseconds": 250 },
    { "action": "capture", "name": "motion-a" },
    { "action": "wait", "milliseconds": 500 },
    { "action": "capture", "name": "motion-b" },
    { "action": "assertPixelsChanged", "from": "motion-a", "to": "motion-b", "region": "TEXT_REGION", "minimumChangedPixels": 10, "tolerance": 8 },
    { "action": "playTo", "compositionId": "OWNER", "state": "Out" },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "out" },
    { "action": "assertPixelsChanged", "from": "motion-b", "to": "out", "minimumChangedPixels": 100, "tolerance": 8 },
    { "action": "playTo", "compositionId": "OWNER", "state": "In" },
    { "action": "wait", "milliseconds": 1000 },
    { "action": "capture", "name": "in-again" },
    { "action": "assertPixelsChanged", "from": "out", "to": "in-again", "minimumChangedPixels": 100, "tolerance": 8 },
    { "action": "setPayload", "compositionId": "OWNER", "payload": "OPERATOR_PAYLOAD" },
    { "action": "assertLifecycle", "event": "error", "equals": 0 }
  ]
}